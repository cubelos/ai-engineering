# LLM provider credentials (at least one key required at runtime)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# Default model id for the chosen provider (see app/config.py)
LLM_MODEL=gpt-4o-mini

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# --- LiteLLM router (primary + fallback) ------------------------------------
# PRIMARY_MODEL is tried first; on failure the wrapper attempts FALLBACK_MODEL
# up to LLM_RETRIES times within LLM_TIMEOUT seconds per attempt.
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT=30
LLM_RETRIES=2

# --- Redis exact-match cache ---------------------------------------------------
# docker-compose overrides this to redis://redis:6379 for the API container.
# For uvicorn on the host, use redis://localhost:6379 and run Redis locally.
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400

# --- Streamlit client ----------------------------------------------------------
# Base URL of this API as seen from the machine running streamlit_app.py.
ESTIMATOR_API_BASE_URL=http://localhost:8000
